# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cholbe?schema=public"

# JWT
JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=development

# File uploads (local storage; swap for S3 in production)
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# App
APP_NAME="Cholbe Pharmacy API"
# Use http://10.0.2.2:3000 when testing uploads on Android emulator
APP_URL="http://localhost:3000"

# Agora video/voice calls
AGORA_APP_ID=""
AGORA_APP_CERTIFICATE=""
